# URL of the Laravel backend (no trailing slash)
VITE_API_URL=http://localhost:8000

# OPTIONAL - a published Spline scene for the hero animals.
# In Spline: Export -> Code -> React -> copy the "scene" URL (ends in .splinecode).
# Leave empty to use the built-in animated 3D-style scene.
VITE_SPLINE_SCENE=
