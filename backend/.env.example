APP_NAME="Paw Avenue Sanctuary API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Comma-separated list of frontend origins allowed by CORS
FRONTEND_URL=http://localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# ---- PostgreSQL ----
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=paw_avenue
DB_USERNAME=postgres
DB_PASSWORD=postgres

# The API is stateless (Sanctum bearer tokens)
SESSION_DRIVER=array
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=public

# Seeded admin account (CHANGE THESE before going live)
ADMIN_NAME="Paw Avenue Sanctuary Admin"
ADMIN_EMAIL=admin@pawavenue.test
ADMIN_PASSWORD=ChangeMe123!

# Sanctum token lifetime in minutes (default 1 day)
SANCTUM_EXPIRATION=1440
